@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var session = HttpContextAccessor.HttpContext?.Session;
    var rol = session?.GetString("Rol");
    var nombreUsuario = session?.GetString("NombreUsuario");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StellarMinds</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StellarMinds.WebApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">StellarMinds</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Inicio</a></li>
                        @if (rol != "Socio")
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Equipos" asp-action="Index">Equipos</a></li>
                        }
                        @if (rol == "Administrador")
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Socios" asp-action="Create">Alta socio</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Auditorias" asp-action="Index">Auditoria</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Equipos" asp-action="SociosPorTelescopio">Socios por telescopio</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="ObjetosCelestes" asp-action="Ranking">Ranking</a></li>
                        }
                        @if (rol == "Coordinador")
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Prestamos" asp-action="Create">Alta prestamo</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Prestamos" asp-action="Devolucion">Devolucion</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Equipos" asp-action="SociosPorTelescopio">Socios por telescopio</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="ObjetosCelestes" asp-action="Ranking">Ranking</a></li>
                        }
                        @if (rol == "Socio")
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Observaciones" asp-action="Create">Observaciones</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Prestamos" asp-action="MisPrestamos">Mis prestamos</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="ObjetosCelestes" asp-action="Ranking">Ranking</a></li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        @if (!string.IsNullOrWhiteSpace(nombreUsuario))
                        {
                            <span class="text-muted">@nombreUsuario (@rol)</span>
                            <form asp-controller="Usuario" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-outline-secondary btn-sm" type="submit">Salir</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-primary btn-sm" asp-controller="Usuario" asp-action="Login">Login</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Mensaje"] is string mensaje)
            {
                <div class="alert alert-success">@mensaje</div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger">@error</div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
