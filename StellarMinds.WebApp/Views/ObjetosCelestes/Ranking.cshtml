@model RankingObjetosCelestesViewModel
@{
    ViewData["Title"] = "Ranking objetos celestes";
}

<h1>Ranking de objetos celestes</h1>

@if (!string.IsNullOrWhiteSpace(Model.Mensaje))
{
    <div class="alert alert-info">@Model.Mensaje</div>
}

@if (Model.Ranking.Any())
{
    <table class="table table-sm table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Tipo</th>
                <th>Cantidad</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Ranking)
            {
                <tr>
                    <td>@item.Nombre</td>
                    <td>@item.Tipo</td>
                    <td>@item.CantidadVecesObservado</td>
                </tr>
            }
        </tbody>
    </table>
}
